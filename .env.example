# Copiá este archivo como .env para configurar el acceso local a OpenAI.
# Nunca reemplaces este valor con una API key real dentro del repositorio.
OPENAI_API_KEY=your-key-here
EMBEDDING_MODEL=text-embedding-3-small
# Elegí localmente un modelo habilitado para tu cuenta; el chequeo rechaza este valor vacío.
RESPONSE_MODEL=gpt-5.4-nano
CHROMA_PATH=chroma_db
COLLECTION_NAME=qa_memory
RELEVANCE_THRESHOLD=0.20
